{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "skipLibCheck": true,

    /* Mesma severidade do app web — o backend não é lugar para afrouxar. */
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

    /* O domínio resolve pelo symlink do workspace (node_modules), não por
       "paths": assim o tipo que o tsc vê e o arquivo que o Node carrega em
       produção são exatamente o mesmo dist. */
  },
  "include": ["src"]
}
